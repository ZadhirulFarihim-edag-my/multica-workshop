generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum ProjectStatus {
  planning
  active
  archived
}

enum TaskStatus {
  todo
  in_progress
  review
  blocked
  done
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

enum TeamMemberStatus {
  active
  inactive
  invited
}

model TeamMember {
  id        String           @id
  name      String
  email     String           @unique
  role      String
  status    TeamMemberStatus  @default(active)
  avatarUrl String?
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  ownedProjects   Project[]     @relation("ProjectOwner")
  assignedTasks   Task[]        @relation("TaskAssignee")
  authoredComments TaskComment[] @relation("CommentAuthor")
  authoredLogs     ActivityLog[] @relation("ActivityActor")
}

model Project {
  id          String         @id
  name        String
  description String?
  status      ProjectStatus  @default(active)
  ownerId     String
  color       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  owner   TeamMember     @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  tasks   Task[]
  logs    ActivityLog[]

  @@index([ownerId])
}

model Task {
  id          String        @id
  projectId   String
  title       String
  description String?
  status      TaskStatus    @default(todo)
  priority    TaskPriority  @default(medium)
  assigneeId  String?
  dueDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee TeamMember?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments TaskComment[]
  logs     ActivityLog[]

  @@index([projectId])
  @@index([assigneeId])
}

model TaskComment {
  id              String       @id
  taskId          String
  content         String
  authorId        String?
  parentCommentId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  task          Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author        TeamMember?   @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  parentComment TaskComment?  @relation("TaskCommentThread", fields: [parentCommentId], references: [id], onDelete: SetNull)
  replies       TaskComment[] @relation("TaskCommentThread")

  @@index([taskId])
  @@index([authorId])
  @@index([parentCommentId])
}

model ActivityLog {
  id        String      @id
  projectId String
  taskId    String?
  actorId   String?
  action    String
  summary   String
  createdAt DateTime    @default(now())

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task?       @relation(fields: [taskId], references: [id], onDelete: SetNull)
  actor   TeamMember? @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([taskId])
  @@index([actorId])
}
