    "prisma": "^7.8.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "dotenv": "^17.4.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
